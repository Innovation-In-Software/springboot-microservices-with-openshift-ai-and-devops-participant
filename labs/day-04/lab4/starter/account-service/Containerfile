# Lab 4 starter — Account Service image
# Build context is labs/day-03/lab3/starter/account-service (see docker-compose.yml).

FROM maven:3.9.9-eclipse-temurin-21-alpine AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /src/target/*.jar app.jar

# TODO Lab 4 Step 2 — create a non-root user and switch to it (do not run as root).
# TODO Lab 4 Step 2 — EXPOSE 8081

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
